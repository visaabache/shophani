{
  "name": "maroc-store",
  "version": "1.0.0",
  "description": "Multilingual (AR/FR/EN) cash-on-delivery store for Morocco on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply maroc-store --local",
    "db:seed:local": "wrangler d1 execute maroc-store --local --file seed/sample.sql",
    "db:migrate": "wrangler d1 migrations apply maroc-store --remote",
    "db:seed": "wrangler d1 execute maroc-store --remote --file seed/sample.sql",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "private": true,
  "type": "module"
}

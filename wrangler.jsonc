// Cloudflare Worker for the store. See README.md for first-time setup.
{
  "name": "shophani",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker renders the storefront pages itself and passes /assets/* and /admin/* on to the static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shophani",
      // Paste the id printed by: npx wrangler d1 create shophani
      "database_id": "018a52d1-ae99-4901-a3c2-c79f402a3772",
      "migrations_dir": "migrations"
    }
  ],
  // The store's public address. www.shophani.online and the workers.dev address redirect here, and it is used
  // for canonical links, the sitemap and Google's structured data.
  "vars": { "SITE_URL": "https://shophani.online" },
  // shophani.online must be added to this Cloudflare account (nameservers pointed to Cloudflare at the registrar).
  "routes": [
    { "pattern": "shophani.online", "custom_domain": true },
    { "pattern": "www.shophani.online", "custom_domain": true }
  ],
  // Still reachable at https://shophani.<your-subdomain>.workers.dev (it redirects to SITE_URL).
  "workers_dev": true,
  // Photo uploads from the admin need R2, which Cloudflare only turns on once a payment card is on the account
  // (the first 10 GB stay free). Until then, product photos can be links. To turn uploads on:
  //   npx wrangler r2 bucket create shophani-images
  // then add:  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "shophani-images" }],
  "observability": { "enabled": true }
}

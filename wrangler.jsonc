// Cloudflare Worker for the store. See README.md for first-time setup.
{
  "name": "maroc-store",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker renders the storefront pages itself and passes /assets/* and /admin/* on to the static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maroc-store",
      // Paste the id printed by: npx wrangler d1 create maroc-store
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Product photos uploaded from the admin. Create it once with: npx wrangler r2 bucket create maroc-store-images
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "maroc-store-images" }],
  "observability": { "enabled": true }
}
